{
  "name": "ostraops-guard",
  "version": "0.1.0",
  "description": "Inline financial gateway and telemetry proxy for autonomous AI coding agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ostraops-guard": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "ui/dist",
    "README.md"
  ],
  "keywords": [
    "ostraops",
    "sentinel",
    "finops",
    "ai-agent",
    "telemetry",
    "proxy",
    "firewall",
    "cursor",
    "cline"
  ],
  "author": "OstraOps",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stoppingarc01-ai/Ostra-FinOps.git",
    "directory": "packages/guard-daemon"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "start": "node bin/cli.js",
    "build:ui": "vite build --config ui/vite.config.ts",
    "test:stage1": "npx tsx test/stage1-check.ts",
    "test:stage2": "npx tsx test/stage2-check.ts",
    "test:stage2.1": "npx tsx test/stage2-chaos-check.ts",
    "test:stage3": "npx tsx test/stage3-ui-check.ts",
    "test:parity": "npx tsx test/backend-parity-check.ts",
    "test:ingress": "npx tsx test/ingress-proxy-check.ts",
    "test:all": "npx tsx test/stage1-check.ts && npx tsx test/stage2-check.ts && npx tsx test/stage2-chaos-check.ts && npx tsx test/stage3-ui-check.ts && npx tsx test/backend-parity-check.ts && npx tsx test/ingress-proxy-check.ts",
    "test": "npm run test:all"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.19.3",
    "typescript": "~6.0.2"
  }
}
